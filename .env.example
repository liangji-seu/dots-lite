CODEX_BRIDGE_HOST=0.0.0.0
CODEX_BRIDGE_PORT=8765
# Generate locally with scripts/configure.py. Never commit a real token.
CODEX_BRIDGE_TOKEN=
CODEX_BRIDGE_DEVICE_ID=windows-desktop
CODEX_BRIDGE_DEVICE_NAME=Windows Desktop
CODEX_PROJECT_CONFIG=config/projects.json
CODEX_EXECUTABLE=codex
# Local operator chooses permissions/model; remote requests cannot override them.
CODEX_SANDBOX=read-only
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=high
# A task record cap returns 503 when full; restart clears in-memory history.
CODEX_MAX_TASKS=100
CODEX_MAX_QUEUE_SIZE=64
CODEX_MAX_OUTPUT_CHARS=262144
CODEX_MAX_EVENTS=2048
CODEX_MAX_EVENT_BYTES=524288
CODEX_TASK_TIMEOUT_SECONDS=3600
